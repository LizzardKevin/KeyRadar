{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LizzardKevin/KeyRadar/schemas/keyradar-rule-v2.schema.json",
  "title": "KeyRadar application variant rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "applicationId", "variantId", "displayName", "match", "hotkeys"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "applicationId": { "$ref": "#/$defs/identifier" },
    "variantId": { "$ref": "#/$defs/identifier" },
    "displayName": { "$ref": "#/$defs/localizedText" },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executables", "publishers", "versionRange", "packageFamilyNames", "distribution"],
      "properties": {
        "executables": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^\\/:*?\"<>|]+\\.exe$", "maxLength": 260 }
        },
        "publishers": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "versionRange": {
          "type": ["string", "null"],
          "pattern": "^(?:[<>]=?|={1,2})?[0-9]+(?:\\.[0-9]+){0,3}(?: (?:[<>]=?|={1,2})?[0-9]+(?:\\.[0-9]+){0,3}){0,3}$",
          "maxLength": 100
        },
        "packageFamilyNames": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "distribution": {
          "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        }
      }
    },
    "hotkeys": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gesture", "function", "scope", "confidence"],
        "properties": {
          "gesture": { "type": "string", "minLength": 1, "maxLength": 64 },
          "function": { "$ref": "#/$defs/localizedText" },
          "scope": { "enum": ["foreground", "background", "global", "windowsSystem"] },
          "confidence": {
            "enum": ["configuration", "hardwareMapping", "systemKnown", "officialDefault", "corroborated", "suspected"]
          },
          "sources": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "format": "uri", "maxLength": 500 }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": { "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 160 }
    }
  }
}
