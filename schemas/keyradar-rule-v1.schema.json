{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LizzardKevin/KeyRadar/schemas/keyradar-rule-v1.schema.json",
  "title": "KeyRadar declarative application rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "applicationId", "displayName", "executables", "shortcuts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "applicationId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "executables": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[^\\/:*?\"<>|]+\\.exe$" }
    },
    "shortcuts": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gesture", "function", "scope", "confidence"],
        "properties": {
          "gesture": { "type": "string", "minLength": 1, "maxLength": 64 },
          "function": { "type": "string", "minLength": 1, "maxLength": 160 },
          "scope": { "enum": ["application", "global", "windowsSystem"] },
          "confidence": { "enum": ["configuration", "systemKnown", "suspected"] },
          "sources": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "format": "uri", "maxLength": 500 }
          }
        }
      }
    }
  }
}
