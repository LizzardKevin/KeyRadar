<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeyRadar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KeyRadar"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="RadarAccentBrush" Color="#62D9D6" />
        <SolidColorBrush x:Key="RadarPanelBrush" Color="#9910212E" />
        <SolidColorBrush x:Key="RadarBorderBrush" Color="#2BFFFFFF" />
        <SolidColorBrush x:Key="RadarMutedBrush" Color="#FF8EA6B2" />
        <SolidColorBrush x:Key="RadarSuccessBrush" Color="#FF76E5BD" />
        <SolidColorBrush x:Key="RadarWarningBrush" Color="#FFFFB59B" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="#42051018"
            BorderBrush="{StaticResource RadarBorderBrush}"
            BorderThickness="0,0,1,0">
            <StackPanel Padding="12,20" Spacing="4">
                <TextBlock Margin="12,0,0,14" Foreground="{StaticResource RadarMutedBrush}" Text="导航" />
                <RadioButton x:Name="RadarOverviewNav" Click="RadarOverviewNav_Click" GroupName="MainNavigation" IsChecked="True">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE9D9;" />
                        <TextBlock x:Uid="NavRadar" Text="雷达总览" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="HotkeyOverviewNav" Click="HotkeyOverviewNav_Click" GroupName="MainNavigation">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE774;" />
                        <TextBlock x:Uid="NavHotkeys" Text="热键总览" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="SettingsNav" Click="SettingsNav_Click" GroupName="MainNavigation">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                        <TextBlock x:Uid="NavSettings" Text="设置" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1040" Padding="28,24,30,42" HorizontalAlignment="Stretch" Spacing="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" FontSize="28" FontWeight="SemiBold" Text="雷达总览" />
                        <TextBlock x:Name="SummaryText" Margin="0,5,0,0" Foreground="{StaticResource RadarMutedBrush}" Text="正在扫描当前前后台应用…" />
                    </StackPanel>
                    <Button Grid.Column="1" HorizontalAlignment="Right" Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="重新扫描" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CheckUpdateButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        Click="CheckUpdateButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock x:Name="CheckUpdateButtonText" Text="检查更新" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RulesMenuButton" Grid.Column="3" Margin="8,0,0,0">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="UpdateRulesMenuItem" Click="UpdateRulesButton_Click" Icon="Download" Text="更新官方规则" />
                                <MenuFlyoutItem x:Name="RollbackRulesMenuItem" Click="RollbackRulesButton_Click" Text="回滚官方规则" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="ImportOfficialRulesButton_Click" Text="导入官方签名 .krpack…" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8F1;" />
                            <TextBlock Text="规则库" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ExportDiagnosticsButton"
                        Grid.Column="4"
                        Margin="8,0,0,0"
                        Click="ExportDiagnosticsButton_Click"
                        Content="导出诊断" />
                </Grid>

                <StackPanel x:Name="RadarOverviewPanel" Spacing="14">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="18" Background="#4A5B232D" BorderBrush="#66FF8A9B" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="9">
                                <FontIcon HorizontalAlignment="Left" Foreground="#FFFF8A9B" Glyph="&#xEA39;" />
                                <TextBlock x:Name="ConflictCountText" FontSize="30" FontWeight="SemiBold" Text="0" />
                                <TextBlock x:Uid="CardConflicts" Text="冲突" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="18" Background="#3A164A3E" BorderBrush="#5576E5BD" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="9">
                                <FontIcon HorizontalAlignment="Left" Foreground="{StaticResource RadarSuccessBrush}" Glyph="&#xE73E;" />
                                <TextBlock x:Name="AvailableCountText" FontSize="30" FontWeight="SemiBold" Text="0" />
                                <TextBlock x:Uid="CardAvailable" Text="当前可注册" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="18" Background="#3A17364E" BorderBrush="#557AB8F5" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="9">
                                <FontIcon HorizontalAlignment="Left" Foreground="#FF86C5FF" Glyph="&#xE7C4;" />
                                <TextBlock x:Name="ForegroundCountText" FontSize="30" FontWeight="SemiBold" Text="0" />
                                <TextBlock x:Uid="CardForeground" Text="前台热键" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="18" Background="#3A4A3A16" BorderBrush="#55E6C46D" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="9">
                                <FontIcon HorizontalAlignment="Left" Foreground="#FFFFD67D" Glyph="&#xE9CE;" />
                                <TextBlock x:Name="UnconfirmedCountText" FontSize="30" FontWeight="SemiBold" Text="0" />
                                <TextBlock x:Uid="CardUnconfirmed" Text="待确认" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Padding="20" Background="{StaticResource RadarPanelBrush}" BorderBrush="{StaticResource RadarBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Width="56" FontSize="38" Foreground="{StaticResource RadarAccentBrush}" Glyph="&#xE9D9;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock x:Uid="CurrentSession" FontSize="18" FontWeight="SemiBold" Text="当前桌面会话" />
                                <TextBlock x:Name="DashboardStatusText" Foreground="{StaticResource RadarMutedBrush}" Text="正在建立当前可发现热键快照…" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Uid="RescanButton" Grid.Column="2" Click="RefreshButton_Click" Content="重新扫描" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="HotkeyOverviewPanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Uid="HotkeyOverviewTitle" FontSize="20" FontWeight="SemiBold" Text="热键总览" />

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Height="44"
                    PlaceholderText="按下组合键，或输入应用、功能名称"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />

                <InfoBar
                    x:Name="RuleStatusInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error"
                    Title="规则不可用" />

                <InfoBar
                    x:Name="ConflictInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Message="同一组合键存在多个运行中的候选归属。"
                    Severity="Warning"
                    Title="发现热键冲突" />

                <Border
                    Padding="14,11"
                    Background="#321A6E68"
                    BorderBrush="#4A62D9D6"
                    BorderThickness="1"
                    CornerRadius="9">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="ScanProgress" Width="18" Height="18" IsActive="True" />
                        <TextBlock x:Name="ScanStatusText" Grid.Column="1" VerticalAlignment="Center" Text="正在安全读取窗口、进程与规则证据" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource RadarMutedBrush}" Text="不模拟 · 不拦截" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="ApplicationGroupsView" HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind FilteredGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ApplicationGroupViewModel">
                            <Expander
                                Margin="0,0,0,10"
                                Background="{StaticResource RadarPanelBrush}"
                                BorderBrush="{StaticResource RadarBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                IsExpanded="{x:Bind IsExpanded}">
                                <Expander.Header>
                                    <Grid Padding="4,2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="#304DCCD0" CornerRadius="8">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Glyph="{x:Bind IconGlyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                <TextBlock Foreground="{StaticResource RadarSuccessBrush}" Text="{x:Bind PresenceLabel}" />
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="{StaticResource RadarMutedBrush}" Text="{x:Bind EvidenceSummary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource RadarMutedBrush}" Text="{x:Bind HotkeyCountLabel}" />
                                        <Button
                                            Grid.Column="3"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Click="JumpToApplication_Click"
                                            Content="转到应用  ↗"
                                            IsEnabled="{x:Bind CanJump}"
                                            Tag="{x:Bind ProcessId}" />
                                    </Grid>
                                </Expander.Header>

                                <ItemsControl ItemsSource="{x:Bind Hotkeys}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:HotkeyRowViewModel">
                                            <Grid Padding="15,11" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" MinWidth="150" />
                                                    <ColumnDefinition Width="126" />
                                                    <ColumnDefinition Width="104" />
                                                </Grid.ColumnDefinitions>
                                                <Border HorizontalAlignment="Left" Padding="9,5" Background="#FF132F3E" BorderBrush="#516AD9DB" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock FontFamily="Cascadia Mono" Foreground="#FFC9FFFF" Text="{x:Bind Gesture}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Function}" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource RadarMutedBrush}" Text="{x:Bind ScopeLabel}" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource RadarMutedBrush}" Text="{x:Bind EvidenceLabel}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource RadarSuccessBrush}" Text="{x:Bind ConfidenceLabel, Mode=OneWay}" />
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                                    <Button
                                                        Click="DeepConfirmButton_Click"
                                                        Content="深度确认"
                                                        IsEnabled="{x:Bind CanDeepConfirm}"
                                                        Tag="{x:Bind}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" Padding="32" HorizontalAlignment="Center" Visibility="Collapsed">
                    <FontIcon HorizontalAlignment="Center" FontSize="36" Foreground="{StaticResource RadarMutedBrush}" Glyph="&#xE9D9;" />
                    <TextBlock Margin="0,12,0,0" FontSize="18" HorizontalAlignment="Center" Text="当前筛选没有匹配项" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource RadarMutedBrush}" Text="清空搜索可查看全部已识别热键" />
                </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SettingsPanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Uid="AppearanceTitle" FontSize="20" FontWeight="SemiBold" Text="外观与语言" />
                    <Border Padding="18" Background="{StaticResource RadarPanelBrush}" BorderBrush="{StaticResource RadarBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="LanguageLabel" VerticalAlignment="Center" Text="显示语言" />
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                <ComboBoxItem Content="English" Tag="en-US" />
                            </ComboBox>
                            <TextBlock x:Uid="ThemeLabel" Grid.Row="1" VerticalAlignment="Center" Text="应用主题" />
                            <ComboBox x:Name="ThemeComboBox" Grid.Row="1" Grid.Column="1" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                <ComboBoxItem Content="浅色" Tag="light" />
                                <ComboBoxItem Content="深色" Tag="dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <TextBlock x:Uid="MaintenanceTitle" FontSize="20" FontWeight="SemiBold" Text="维护与规则" />
                    <Border Padding="18" Background="{StaticResource RadarPanelBrush}" BorderBrush="{StaticResource RadarBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="CheckUpdateButton_Click" Content="检查程序更新" />
                            <Button Click="UpdateRulesButton_Click" Content="下载最新规则包" />
                            <Button Click="OpenMyRulesButton_Click" Content="我的规则" />
                            <Button Click="SubmitCandidateRuleButton_Click" Content="上传候选规则" />
                            <Button Click="ExportDiagnosticsButton_Click" Content="导出诊断" />
                        </StackPanel>
                    </Border>
                    <InfoBar IsClosable="False" IsOpen="True" Severity="Informational" Title="能力边界" Message="低级 Hook、Raw Input、驱动层拦截、私有或云端 Profile、板载宏及上下文热键可能无法完整发现；无法安全归属时始终显示未知。" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
