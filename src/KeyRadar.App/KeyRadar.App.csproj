<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>KeyRadar</RootNamespace>
    <AssemblyName>KeyRadar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <DevelopmentRulePackDirectory>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</DevelopmentRulePackDirectory>
    <DevelopmentRulePackPath>$(DevelopmentRulePackDirectory)KeyRadar-Development-Rules.krpack</DevelopmentRulePackPath>
    <DevelopmentRulePackFingerprintSource>$(DevelopmentRulePackDirectory)DevelopmentRulePackFingerprint.g.cs</DevelopmentRulePackFingerprintSource>
    <DevelopmentRulePackVersionStamp>$(DevelopmentRulePackDirectory)DevelopmentRulePackVersion.stamp</DevelopmentRulePackVersionStamp>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <DevelopmentRulePackInputs Include="$(MSBuildProjectDirectory)\..\..\eng\Build-DebugRulePack.ps1" />
    <DevelopmentRulePackInputs Include="$(MSBuildProjectDirectory)\..\..\rules\*.json" />
    <DevelopmentRulePackInputs Include="$(MSBuildProjectFullPath)" />
    <DevelopmentRulePackInputs Include="$(DevelopmentRulePackVersionStamp)" />
    <Compile Include="$(DevelopmentRulePackFingerprintSource)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyRadar.Core\KeyRadar.Core.csproj" />
    <ProjectReference Include="..\KeyRadar.Rules\KeyRadar.Rules.csproj" />
    <ProjectReference Include="..\KeyRadar.Update\KeyRadar.Update.csproj" />
    <ProjectReference Include="..\KeyRadar.Windows\KeyRadar.Windows.csproj" />
    <ProjectReference Include="..\KeyRadar.ElevatedScanner\KeyRadar.ElevatedScanner.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyElevatedScanner" AfterTargets="Build">
    <MSBuild Projects="..\KeyRadar.ElevatedScanner\KeyRadar.ElevatedScanner.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64;RestoreLockedMode=true" />
    <ItemGroup>
      <ElevatedScannerFiles Include="..\KeyRadar.ElevatedScanner\bin\x64\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ElevatedScannerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="WriteDevelopmentRulePackVersionStamp">
    <MakeDir Directories="$(DevelopmentRulePackDirectory)" />
    <WriteLinesToFile File="$(DevelopmentRulePackVersionStamp)" Lines="$(Version)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="BuildDevelopmentRulePack"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="WriteDevelopmentRulePackVersionStamp"
          Inputs="@(DevelopmentRulePackInputs)"
          Outputs="$(DevelopmentRulePackPath);$(DevelopmentRulePackFingerprintSource)">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\eng\Build-DebugRulePack.ps1&quot; -RulesDirectory &quot;$(MSBuildProjectDirectory)\..\..\rules&quot; -OutputPath &quot;$(DevelopmentRulePackPath)&quot; -Version &quot;$(Version)&quot; -FingerprintSourcePath &quot;$(DevelopmentRulePackFingerprintSource)&quot;" />
  </Target>

  <Target Name="CopyDevelopmentRulePack" AfterTargets="Build">
    <Copy SourceFiles="$(DevelopmentRulePackPath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
